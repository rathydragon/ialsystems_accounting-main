# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# Admin PIN Code for Direct Login (optional, default: 123456)
VITE_ADMIN_PIN="123456"

# Google Apps Script Web App Deployment URL (Unified across Local & Vercel)
VITE_GOOGLE_WEBAPP_URL="https://script.google.com/macros/s/AKfycbxJfGBTd2iGI3cf2xaIs19p1Oha6QxbS5Rquu0NH7ZAbzrTMUdimG_LE3DynlEU6pQReA/exec"

# Google Spreadsheet Configuration Links (Optional defaults for Local & Vercel)
VITE_FOLLOWUP_BM_SHEET_URL="https://docs.google.com/spreadsheets/d/1C-CYb14ZM146RiD87yjS_rxGmWk1hib4jkoTDT6O-I8/edit?gid=0#gid=0"
VITE_FOLLOWUP_BM_SHEET_NAME="Data_BM"

VITE_DATA_BM_SHEET_URL="https://docs.google.com/spreadsheets/d/1C-CYb14ZM146RiD87yjS_rxGmWk1hiB4jkoTDT6O-I8/edit#gid=764804833"
VITE_DATA_BM_SHEET_NAME="Sort_pending"

VITE_SOKIMEX_SHEET_URL="https://docs.google.com/spreadsheets/d/1OQFwNcbajxsKLu6-y-Bi7tQaXQIn08lPfAog8LnwmXE/edit?gid=1104637417#gid=1104637417"
VITE_SOKIMEX_SHEET_NAME="Data_Sokimic"

VITE_METERIAL_OFFICE_SHEET_URL="https://docs.google.com/spreadsheets/d/1gOjRT40t9RVIIym0Y-Pv_jz0VSkt--icUDrtti-Ljd8/edit?gid=0#gid=0"
VITE_METERIAL_OFFICE_SHEET_NAME="Truck_Tuk Tuk"

VITE_DATA_REPORT_SHEET_URL="1yiKxEP7LnvIK2UjhrpnnI4YI4tMbMOFe8hF4dmSSKn8"
VITE_DATA_REPORT_SHEET_NAME="DATA"

# Cloud Supabase Realtime Database Configuration
VITE_SUPABASE_URL="https://tinrrnfxrbwzrqcyvdlo.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Local PostgreSQL Backup Configuration (Optional, defaults to localhost:5432)
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_postgres_password"
PG_DATABASE="ialsystems_backup"

# Cloud Supabase PostgreSQL Backup Configuration (Optional, Multi-Destination Backup)
# Get from Supabase: Project Settings > Database > Connection string > URI
SUPABASE_DB_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

