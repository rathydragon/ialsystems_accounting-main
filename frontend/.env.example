# ===================================================
# IAL Systems Accounting - Frontend Environment Variables
# ===================================================

# Backend API URL (Leave blank for local dev proxy or specify deployed backend URL)
VITE_BACKEND_URL="http://localhost:5000"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# !!! Every VITE_* variable is PUBLIC (inlined into the browser bundle).
# Never put secrets here: the build fails on VITE_*TOKEN / *SECRET / *API_KEY / *PIN.
# Telegram bot tokens and GEMINI_API_KEY belong in backend/.env (or Vercel env
# without the VITE_ prefix): TELEGRAM_BOT_TOKEN, TELEGRAM_PAYMENT_BOT_TOKEN,
# TELEGRAM_SLIP_BOT_TOKEN, TELEGRAM_DISTRIBUTION_BOT_TOKEN, GEMINI_API_KEY.

# Telegram chat IDs (not secret)
VITE_TELEGRAM_CHAT_ID="your_telegram_chat_id"
VITE_TELEGRAM_PAYMENT_CHAT_ID="your_payment_chat_id"
VITE_TELEGRAM_SLIP_CHAT_ID="your_slip_chat_id"
VITE_TELEGRAM_DISTRIBUTION_CHAT_ID="your_distribution_chat_id"
VITE_TELEGRAM_DAILY_SUMMARY_TIME="18:00"

# Google Apps Script Web App Deployment URL
VITE_GOOGLE_WEBAPP_URL="https://script.google.com/macros/s/AKfycbws4AAj2sTC2rDPRk4gBKsEsHUX80Qf1BJ1kf7Lyhgo_MbtoJAvmDmjBBCQlgu41PJFIQ/exec"

