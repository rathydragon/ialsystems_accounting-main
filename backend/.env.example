# Local / Cloud PostgreSQL Database
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_postgres_password"
PG_DATABASE="ialsystems_backup"

# Remote MySQL Master Tracking Database (Hostinger)
