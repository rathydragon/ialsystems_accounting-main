# ===================================================
# IAL Systems Accounting - Backend Environment Variables
# ===================================================

# Server Configuration
PORT=5000
HOST="0.0.0.0"
NODE_ENV="production"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# Trust any 192.168.x.x / 10.x.x.x origin in production (default: only outside production)
CORS_ALLOW_LAN=false
# REQUIRED in production (min 32 chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate_a_secure_random_64_character_hex_secret_key_here"

# Local / Cloud PostgreSQL Database
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_postgres_password"
PG_DATABASE="ialsystems_backup"

# Remote MySQL Master Tracking Database (Hostinger)
REMOTE_DB_HOST="srv1366.hstgr.io"
REMOTE_DB_PORT="3306"
REMOTE_DB_USER="u112951411_user"
REMOTE_DB_PASSWORD="your_remote_db_password"
REMOTE_DB_NAME="u112951411_iale_api"
REMOTE_DB_SSL="true"
REMOTE_DB_SSL_STRICT="false"

# Gemini AI key for bank slip OCR (server-side only, used by /api/gemini-proxy)
GEMINI_API_KEY=""

# Telegram Bot Proxy Configuration (Server-side alerts)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="-100123456789"
TELEGRAM_PAYMENT_BOT_TOKEN=""
TELEGRAM_PAYMENT_CHAT_ID=""
TELEGRAM_LOG_BOT_TOKEN=""
TELEGRAM_LOG_CHAT_ID=""
TELEGRAM_DISTRIBUTION_BOT_TOKEN=""
TELEGRAM_DISTRIBUTION_CHAT_ID=""
TELEGRAM_SLIP_BOT_TOKEN=""
TELEGRAM_SLIP_CHAT_ID=""

# Rate Limiting & Security Policies
RATE_LIMIT_MAX=5000
LOGIN_RATE_LIMIT_MAX=10
ENABLE_CSP="false"

# Google Apps Script & Sheet Fallbacks for Backend Sync
VITE_GOOGLE_WEBAPP_URL="https://script.google.com/macros/s/.../exec"
VITE_POD_BACKUP_SHEET_URL="https://docs.google.com/spreadsheets/d/.../edit?gid=0#gid=0"
VITE_POD_BACKUP_SHEET_ID="your_google_sheet_id_here"
VITE_POD_BACKUP_SHEET_NAME="ialsystems_backup_pod"
VITE_POD_BACKUP_WEBAPP_URL="https://script.google.com/macros/s/.../exec"

